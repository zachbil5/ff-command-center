    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ffc/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
