# Template for local env vars. Copy to .env.local (gitignored) and fill in.
# Real values live only in .env.local and in Vercel project settings (DESIGN §9).
# Non-secret config (base URLs, TTLs, limits) lives in packages/config, not here.

# Postgres. Leave unset locally to use PGlite under .data/ (run `pnpm db:migrate` once).
# On Vercel the Neon integration sets this per environment.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth: session signing secret (32+ random bytes, base64) and this deployment's origin.
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# The account that manages invites; always allowed to sign up.
OWNER_EMAIL=you@example.com

# M3b: Yahoo Fantasy Sports app (scope fspt-r, read-only) and token encryption key.
# YAHOO_CLIENT_ID=replace-me
# YAHOO_CLIENT_SECRET=replace-me
# TOKEN_ENCRYPTION_KEY=replace-me
# TOKEN_ENCRYPTION_KEY_ID=k1

# Shared secret Vercel Cron sends to scheduled jobs (later milestone).
# CRON_SECRET=replace-me
