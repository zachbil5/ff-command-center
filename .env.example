# Template for local env vars. Copy to .env.local (gitignored) and fill in.
# Real values live only in .env.local and in Vercel project settings (DESIGN §9).
# Non-secret config (base URLs, TTLs, limits) lives in packages/config, not here.

# Postgres (Neon). Use a separate branch/database per environment.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Better Auth session signing secret (32+ random bytes, base64)
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=https://localhost:3000

# Google sign-in for the app (invite-only)
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Yahoo Fantasy Sports API app (scope fspt-r, read-only)
YAHOO_CLIENT_ID=replace-me
YAHOO_CLIENT_SECRET=replace-me

# AES-256-GCM key for provider tokens at rest (32 random bytes, base64) and its id
TOKEN_ENCRYPTION_KEY=replace-me
TOKEN_ENCRYPTION_KEY_ID=k1

# Shared secret Vercel Cron sends to the daily player-refresh job
CRON_SECRET=replace-me
